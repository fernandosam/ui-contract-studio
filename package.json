{
  "name": "ui-contract-studio",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:impact": "node scripts/report-contract-impact.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "docs:check": "node scripts/check-docs.mjs",
    "security:check": "node scripts/audit-security.mjs",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc -b --pretty false",
    "lint": "eslint .",
    "check:catalog": "tsx scripts/check-ui-catalog.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check": "node scripts/run-checks.mjs",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.integration.test.ts",
    "validate": "npm run check && npm run lint && npm run test",
    "test:offline": "node --test tests/*.test.mjs",
    "shadcn:list": "node scripts/install-shadcn.mjs --list",
    "shadcn:preview": "node scripts/install-shadcn.mjs --dry-run",
    "shadcn:install": "node scripts/install-shadcn.mjs --apply",
    "shadcn:status": "node scripts/check-shadcn-install.mjs",
    "shadcn:verify": "node scripts/check-shadcn-install.mjs --strict",
    "test:e2e": "playwright test --grep-invert \"snapshot visual|@reference-visual|@block-visual|@composite-fidelity|@official-docs\"",
    "test:e2e:install": "playwright install chromium",
    "test:catalog": "node --test tests/*.test.mjs",
    "bootstrap": "npm run shadcn:install && npm run shadcn:verify && npm run shadcn:integrity -- --strict && npm run validate && npm run build",
    "check:extensions": "node scripts/check-extension-dependencies.mjs",
    "contracts:check": "node scripts/check-contract-versions.mjs",
    "screens:check": "node scripts/check-screen-discovery.mjs",
    "shadcn:integrity": "node scripts/check-shadcn-integrity.mjs",
    "eval:pi": "tsx scripts/evaluate-pi.ts",
    "eval:pi:strict": "tsx scripts/evaluate-pi.ts --strict",
    "test:unit": "node --test tests/*.test.mjs",
    "contracts:diff": "node scripts/check-contract-diff.mjs",
    "patterns:check": "node scripts/check-ui-patterns.mjs",
    "integration:update": "node scripts/generate-integration-status.mjs --write",
    "integration:check": "node scripts/generate-integration-status.mjs --check",
    "eval:pi:context": "tsx scripts/export-pi-catalog.ts",
    "eval:pi:run": "node scripts/run-pi-evals.mjs",
    "eval:pi:report": "tsx scripts/evaluate-pi.ts",
    "bootstrap:connected": "npm install --no-audit --no-fund && npm run shadcn:install && npm install --package-lock-only --no-audit --no-fund && npm run shadcn:verify && npm run integration:update && npm run validate && npm run build",
    "check:dependency-compat": "node scripts/check-dependency-compat.mjs",
    "composites:check": "tsx scripts/check-composite-templates.ts",
    "composites:integrity": "node scripts/check-composite-fingerprints.mjs",
    "blocks:check": "node scripts/check-shadcn-blocks.mjs",
    "blocks:strict": "node scripts/check-shadcn-blocks.mjs --strict",
    "blocks:capture": "playwright test tests/e2e/official-blocks.spec.ts",
    "blocks:compare": "node scripts/build-blocks-comparison.mjs",
    "site:check": "node scripts/check-site-compositions.mjs",
    "site:strict": "node scripts/check-site-compositions.mjs --strict",
    "pi:zod-schema": "tsx scripts/export-pi-schemas.ts",
    "pi:verify": "npm run pi:api:check && npm run pi:fixtures:check && npm run readiness:check",
    "doctor": "node scripts/check-environment.mjs",
    "doctor:strict": "node scripts/check-environment.mjs --strict",
    "pi:context": "node scripts/select-pi-context.mjs",
    "pi:select": "node scripts/select-pi-candidates.mjs",
    "pi:api": "node scripts/build-pi-api.mjs --write",
    "pi:api:check": "node scripts/build-pi-api.mjs --check",
    "pi:fixtures": "node scripts/build-pi-fixtures.mjs --write",
    "pi:fixtures:check": "node scripts/build-pi-fixtures.mjs --check",
    "readiness:check": "node scripts/check-readiness.mjs",
    "pi:validate": "tsx scripts/validate-pi-spec.ts",
    "ci:verify": "npm ci --no-audit --no-fund && npm run shadcn:verify && npm run pi:zod-schema && npm run validate && npm run build",
    "bootstrap:reviewed": "npm install --include=dev --no-audit --no-fund && npm run shadcn:install && npm run shadcn:verify && npm install --package-lock-only --no-audit --no-fund && npm run integration:update && npm run ci:verify",
    "check:core": "node scripts/run-checks.mjs --core",
    "composites:generate": "node scripts/generate-composition-proposals.mjs",
    "composites:generated:check": "node scripts/generate-composite-registry.mjs --check",
    "verify": "npm run validate && npm run build && npm run test:e2e",
    "composites:node-props:generate": "node scripts/generate-composite-node-props.mjs",
    "composites:node-props:check": "node scripts/generate-composite-node-props.mjs --check",
    "composites:fidelity": "node scripts/audit-composite-fidelity.mjs",
    "composites:compare": "node scripts/build-composite-comparison.mjs",
    "composites:capture": "playwright test tests/e2e/composite-fidelity.spec.ts",
    "composites:fidelity:strict": "node scripts/audit-composite-fidelity.mjs --strict",
    "composites:pruning:check": "node scripts/check-composite-pruning.mjs",
    "sandbox:verify": "bash sandbox/run-all-tests.sh",
    "sandbox:registry:probe": "node sandbox/registry-probe.mjs",
    "styles:check": "node --test tests/styles-maintenance.test.mjs",
    "ci:visual:evidence": "node scripts/build-ci-visual-evidence.mjs",
    "shadcn:official:capture": "playwright test tests/e2e/official-components.spec.ts --workers=4 --retries=0 --max-failures=8",
    "shadcn:official:compare": "python3 sandbox/compare_official_components.py",
    "reui:audit": "node scripts/audit-reui-primitives.mjs",
    "reui:audit:check": "node scripts/audit-reui-primitives.mjs --check",
    "composites:inventory": "node scripts/analyze-compositions.mjs --write",
    "composites:inventory:check": "node scripts/analyze-compositions.mjs",
    "composites:impact": "node scripts/analyze-compositions.mjs",
    "shadcn:blocks:sources:sync": "node scripts/sync-shadcn-block-sources.mjs",
    "semantic:enforcement": "node scripts/verify-semantic-audit-policy.mjs",
    "semantic:check": "node scripts/analyze-semantic-knowledge.mjs --check",
    "semantic:report": "node scripts/analyze-semantic-knowledge.mjs --write",
    "semantic:context": "node scripts/analyze-semantic-knowledge.mjs",
    "semantic:ingest": "node scripts/ingest-reui-knowledge.mjs",
    "composites:recommend:check": "tsx scripts/check-composition-recommendations.ts",
    "composites:recommend:pilot": "tsx scripts/show-composition-recommendation.ts",
    "composites:generate:check": "node scripts/generate-composition-proposals.mjs --check",
    "test:composition:pilot": "playwright test tests/e2e/typed-confirmation-pilot.spec.ts --project=desktop --project=mobile",
    "admission:check": "node scripts/admission-engine.mjs --check",
    "admission:publish": "node scripts/admission-engine.mjs --publish",
    "admission:sync": "node scripts/sync-admission-catalog.mjs --write && node scripts/build-pi-api.mjs --write",
    "admission:sync:check": "node scripts/sync-admission-catalog.mjs --check",
    "test:admission:candidates": "playwright test tests/e2e/admission-candidates.spec.ts --project=desktop --project=mobile",
    "admission:evidence:reset": "node scripts/admission-evidence.mjs --reset",
    "admission:evidence:report": "node scripts/admission-evidence.mjs --report",
    "shadcn:official:inventory:check": "node scripts/check-official-visual-inventory.mjs",
    "requirements:preview": "tsx scripts/preview-requirements.ts",
    "requirements:test": "tsx --test tests/ui-requirements.integration.test.ts tests/requirements-traceability.integration.test.ts",
    "requirements:audit": "tsx scripts/audit-requirements-scenarios.ts",
    "requirements:patterns:audit": "tsx scripts/audit-pattern-requirements.ts",
    "requirements:impact": "tsx scripts/audit-requirements-impact.ts",
    "requirements:browser:report": "tsx scripts/verify-requirements-browser-evidence.ts",
    "requirements:evidence:verify": "tsx scripts/verify-requirements-browser-evidence.ts",
    "requirements:browser:prepare": "tsx scripts/prepare-requirements-browser-evidence.ts",
    "semantic:test:e2e": "playwright test tests/e2e/semantic-derived.spec.ts --project=desktop --project=mobile",
    "contracts:migrate": "node scripts/migrate-contract-spec.mjs",
    "contracts:migrations:check": "node scripts/check-contract-migrations.mjs",
    "layout:browser:test": "playwright test tests/e2e/layout-runtime-quality.spec.ts --project=desktop --project=mobile",
    "themes:check": "node scripts/check-versioned-themes.mjs",
    "test:e12": "node --test tests/sdk-access-control.test.mjs tests/e12-gateway-security.test.mjs && tsx --test tests/contract-sdk.integration.test.ts tests/e12-contract-compatibility.integration.test.ts tests/e12-gateway.integration.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@json-render/core": "0.21.3",
    "@json-render/react": "0.21.3",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.15.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.0",
    "globals": "17.13.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "7.1.0",
    "@typescript/native": "npm:typescript@7.0.2"
  }
}
