    "notification_settings_3_help": {
      "type": "Text",
      "props": {
        "text": "Updates at 25%, 50%, 75%, and 100%.",
        "variant": "muted"
      },
      "children": []
    },
    "notification_settings_4_field": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm",
        "align": "stretch",
        "justify": "start"
      },
      "children": [
        "notification_settings_4",
        "notification_settings_4_help"
      ]
    },
    "notification_settings_4": {
      "type": "Checkbox",
      "props": {
        "label": "Market updates",
        "name": "notification_settings_4",
        "defaultChecked": false
      },
      "children": []
    },
    "notification_settings_4_help": {
      "type": "Text",
      "props": {
        "text": "Daily portfolio summary and price alerts.",
        "variant": "muted"
      },
      "children": []
