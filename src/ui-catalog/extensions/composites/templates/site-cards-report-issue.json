{
  "root": "c001",
  "elements": {
    "c001": {
      "type": "Card",
      "props": {
        "title": "Report an issue",
        "description": "What area are you having problems with?",
        "size": "default",
        "maxWidth": "full"
      },
      "children": [
        "c004",
        "c005",
        "c006",
        "c009"
      ]
    },
    "c002": {
      "type": "Select",
      "props": {
        "label": "Area",
        "name": "area_1",
        "options": [
          {
            "label": "Team",
            "value": "team"
          },
          {
            "label": "Billing",
            "value": "billing"
          },
          {
            "label": "Account",
            "value": "account"
          },
          {
            "label": "Deployments",
            "value": "deployments"
          },
          {
            "label": "Support",
            "value": "support"
          }
        ],
        "placeholder": "Select",
        "value": null,
        "defaultValue": null
      },
      "children": []
    },
    "c003": {
      "type": "Select",
      "props": {
        "label": "Security Level",
        "name": "security_level_2",
        "options": [
          {
            "label": "Severity 1 (Highest)",
            "value": "severity-1-highest-"
          },
          {
            "label": "Severity 2",
            "value": "severity-2"
          },
          {
            "label": "Severity 3",
            "value": "severity-3"
          },
          {
            "label": "Severity 4 (Lowest)",
            "value": "severity-4-lowest-"
          }
        ],
        "placeholder": "Select",
        "value": null,
        "defaultValue": null
      },
      "children": []
    },
    "c004": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md"
      },
      "children": [
        "c002",
        "c003"
      ]
    },
    "c005": {
      "type": "Input",
      "props": {
        "label": "Subject",
        "name": "subject_4",
        "type": "text",
        "placeholder": "Subject",
        "value": null,
        "readOnly": false
      },
      "children": []
    },
    "c006": {
      "type": "Textarea",
      "props": {
        "label": "Description",
        "name": "description",
        "placeholder": "Description",
        "rows": 3,
        "value": null
      },
      "children": []
    },
    "c007": {
      "type": "Button",
      "props": {
        "label": "Cancel",
        "variant": "ghost",
        "size": "sm",
        "type": "button"
      },
      "children": [],
      "on": {
        "press": {
          "action": "buttonClick",
          "params": {
            "message": "Demonstração: Cancel (sem efeito externo)"
          }
        }
      }
    },
    "c008": {
      "type": "Button",
      "props": {
        "label": "Submit",
        "variant": "default",
        "size": "sm",
        "type": "button"
      },
      "children": [],
      "on": {
        "press": {
          "action": "buttonClick",
          "params": {
            "message": "Demonstração: Submit (sem efeito externo)"
          }
        }
      }
    },
    "c009": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm",
        "align": "center",
        "justify": "between"
      },
      "children": [
        "c007",
        "c008"
      ]
    }
  }
}
