{
  "root": "n0102",
  "elements": {
    "n0101": {
      "type": "Button",
      "props": {
        "label": "Confirmar",
        "size": "sm",
        "variant": "outline",
        "disabled": false,
        "type": "button"
      },
      "children": [],
      "on": {
        "press": {
          "action": "buttonClick",
          "params": {
            "message": "Prévia: Confirmar (nenhuma operação externa)"
          }
        }
      }
    },
    "n0102": {
