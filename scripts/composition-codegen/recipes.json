      "schemaExport": "acknowledgedActionDialogSchema",
      "review": "required",
      "fixtures": {
        "valid": {
          "trigger": "Excluir",
          "title": "Confirmação",
          "description": "Excluir itens?",
          "acknowledgmentLabel": "Estou ciente",
          "confirmLabel": "Excluir"
        },
        "invalid": [
          {
            "trigger": "Excluir",
            "title": "Confirmar",
            "description": "D",
            "acknowledgmentLabel": "Aceito",
            "confirmLabel": "Excluir",
            "unsafeHtml": "<script/>"
          },
          {
            "trigger": "",
            "title": "Confirmação",
            "description": "D",
            "acknowledgmentLabel": "Aceito",
            "confirmLabel": "Excluir"
          }
        ]
      }
    },
